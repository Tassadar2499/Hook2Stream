@Hook2Stream.Api_HostAddress = http://localhost:5248
@LocalAuthToken = replace-with-local-development-token

GET {{Hook2Stream.Api_HostAddress}}/
Accept: application/json

###

GET {{Hook2Stream.Api_HostAddress}}/health/live
Accept: application/json

###

GET {{Hook2Stream.Api_HostAddress}}/health/ready
Accept: application/json

###

# Local Auth accepts the configured loopback-only development token.
GET {{Hook2Stream.Api_HostAddress}}/api/v1/account/me
Authorization: Bearer {{LocalAuthToken}}
Accept: application/json

###
