{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Mode": "OAuth",
    "LocalToken": "",
    "LocalSubject": "local-development-user",
    "LocalEmail": "local@hook2stream.test",
    "LocalDisplayName": "Local Developer",
    "InviteOnly": true,
    "InvitedEmails": [],
    "InvitedEmailsFile": ""
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "PublicApiBaseUrl": "",
    "PublicWebReturnBaseUrl": ""
  },
  "Legal": {
    "TermsVersion": "2026-09-04",
    "PrivacyVersion": "2026-09-04"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "Bucket": "hook2stream-media",
    "ProvisioningMode": "VerifyOnly",
    "ObjectExpirationMode": "None",
    "CredentialMode": "Auto",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "RequireCredentials": false,
    "ConfigureBucketCors": false,
    "ConfigureBucketLifecycle": false,
    "BrowserUploadOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "StorageEncryption": {
    "Mode": "H2se",
    "KeyringPath": "",
    "AllowLegacyPlaintextReads": false,
    "ChunkSizeBytes": 1048576,
    "MaxConcurrentEncryptions": 8,
    "MaxConcurrentDownloads": 4
  },
  "OperationalPolicy": {
    "UploadUrlMinutes": 10,
    "UploadSessionHours": 24,
    "StagingHours": 24,
    "SupersededArtworkDays": 30,
    "UnpaidProjectDays": 30,
    "PaidSourceDays": 90,
    "PaidOutputDays": 365,
    "ExplicitDeletionDays": 7,
    "DeletionFenceMinutes": 15,
    "IdempotencyDays": 7,
    "RetentionSweepMinutes": 60,
    "RetentionSweepEnabled": false
  },
  "MediaTools": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "ProcessorVersion": "ingest-v1",
    "ProcessTimeoutSeconds": 180
  },
  "Stripe": {
    "Mode": "Fixture",
    "PublicWebBaseUrl": "http://localhost:3000",
    "ApiBaseUrl": "https://api.stripe.com",
    "SecretKey": "",
    "WebhookSecret": "",
    "WebhookToleranceSeconds": 300,
    "PriceIds": {}
  },
  "AllowedHosts": "*"
}
