  "components": {
    "schemas": {
      "AccountResponse": {
        "required": [
          "userId",
          "subject",
          "email",
          "displayName",
          "onboardingRequired",
          "workspaceId",
          "workspaceName",
          "version"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "onboardingRequired": {
            "type": "boolean"
          },
          "workspaceId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "workspaceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "AssetKind": {
        "enum": [
          "audio",
          "cover",
          "visual",
          "brandCharacter"
        ]
      },
      "AssetResponse": {
        "required": [
          "id",
          "kind",
          "state",
          "fileName",
          "contentType",
          "declaredBytes",
          "actualBytes",
          "revision",
          "sortOrder",
          "isActive",
          "failureCode",
          "failureMessage",
          "durationMilliseconds",
          "width",
          "height",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "state": {
            "$ref": "#/components/schemas/AssetState"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "declaredBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "actualBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sortOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          },
          "failureCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "failureMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "AssetState": {
        "enum": [
          "reserved",
          "uploading",
          "uploaded",
          "processing",
          "ready",
          "rejected",
          "deleted"
        ]
      },
      "BrandKitResponse": {
        "required": [
          "id",
          "displayName",
          "primaryColor",
          "secondaryColor",
          "accentColor",
          "headingFont",
          "bodyFont",
          "defaultCta",
          "smartLink",
          "toneRestrictions",
          "characterLayerEnabled",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "primaryColor": {
            "type": "string"
          },
          "secondaryColor": {
            "type": "string"
          },
          "accentColor": {
            "type": "string"
          },
          "headingFont": {
            "type": "string"
          },
          "bodyFont": {
            "type": "string"
          },
          "defaultCta": {
            "type": "string"
          },
          "smartLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "toneRestrictions": {
            "type": [
              "null",
              "string"
            ]
          },
          "characterLayerEnabled": {
            "type": "boolean"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "CompletedPartRequest": {
        "required": [
          "partNumber",
          "eTag"
        ],
        "type": "object",
        "properties": {
          "partNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "eTag": {
            "type": "string"
          }
        }
      },
      "CompleteOnboardingRequest": {
        "required": [
          "workspaceName",
          "acceptTerms",
          "acceptPrivacy",
          "termsVersion",
          "privacyVersion",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "workspaceName": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean"
          },
          "acceptPrivacy": {
            "type": "boolean"
          },
          "termsVersion": {
            "type": "string"
          },
          "privacyVersion": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CompleteUploadRequest": {
        "required": [
          "parts"
        ],
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartRequest"
            }
          }
        }
      },
      "CompleteUploadResponse": {
        "required": [
          "assetId",
          "jobId"
        ],
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateReleaseRequest": {
        "required": [
          "projectLabel",
          "artistName",
          "trackTitle",
          "language",
          "internalNotes",
          "lyricsText",
          "isInstrumental",
          "mode",
          "releaseDate",
          "campaignStartDate"
        ],
        "type": "object",
        "properties": {
          "projectLabel": {
            "type": "string"
          },
          "artistName": {
            "type": "string"
          },
          "trackTitle": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "internalNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "lyricsText": {
            "type": [
              "null",
              "string"
            ]
          },
          "isInstrumental": {
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/components/schemas/ReleaseMode"
          },
          "releaseDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "campaignStartDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "CreateUploadRequest": {
        "required": [
          "kind",
          "fileName",
          "contentType",
          "sizeBytes",
          "replacesAssetId"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
