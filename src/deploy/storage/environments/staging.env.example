DEPLOYMENT_ENVIRONMENT=staging
STORAGE_PROTOCOL_VERSION=1
STORAGE_OBJECT_FORMAT=H2SEv1
STORAGE_TLS_SERVER_NAME=h2s-storage-staging.REPLACE_WITH_TAILNET.ts.net
TAILSCALE_IPV4=REPLACE_WITH_TAILSCALE_IPV4
MINIO_REGION=us-east-1
MINIO_MEDIA_BUCKET=hook2stream-staging-media
MINIO_BACKUP_BUCKET=hook2stream-staging-pg-backups
MINIO_BACKUP_PREFIX=hook2stream/staging/postgres
MINIO_MEDIA_QUOTA_GIB=35
MINIO_BACKUP_QUOTA_GIB=10
BACKUP_RETENTION_DAYS=7
STORAGE_DATA_DIR=/srv/hook2stream-storage/minio-data
SECRETS_DIR=/srv/hook2stream-storage/secrets/current
SECRETS_GID=2000
MANAGED_IDENTITY_INVENTORY_FILE=/srv/hook2stream-storage/release-state/managed-identities.v1
TLS_CERT_FILE=/srv/hook2stream-storage/secrets/current/storage-tls.crt
TLS_KEY_FILE=/srv/hook2stream-storage/secrets/current/storage-tls.key
MINIO_CPU_LIMIT=2.0
MINIO_MEMORY_LIMIT=2G
MINIO_MEMORY_RESERVATION=512M
# Supplied by the immutable storage candidate on the host; shown here only as
# the required syntax. Never deploy these placeholder values.
STORAGE_RELEASE_VERSION=REPLACE_WITH_40_HEX_COMMIT
MINIO_IMAGE=ghcr.io/REPLACE_WITH_OWNER/hook2stream-minio@sha256:REPLACE_WITH_64_HEX_DIGEST
MINIO_MC_IMAGE=docker.io/minio/mc@sha256:REPLACE_WITH_64_HEX_DIGEST
CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE_WITH_64_HEX_DIGEST
