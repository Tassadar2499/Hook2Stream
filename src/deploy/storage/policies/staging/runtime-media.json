{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStagingMedia",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::hook2stream-staging-media"]
    },
    {
      "Sid": "ManageStagingMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": ["arn:aws:s3:::hook2stream-staging-media/*"]
    },
    {
      "Sid": "ProtectStagingProtocolMarker",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::hook2stream-staging-media/hook2stream-system/*"]
    }
  ]
}
