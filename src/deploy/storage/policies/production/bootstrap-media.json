{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectProductionMediaTopology",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetLifecycleConfiguration",
        "s3:ListBucket"
      ],
      "Resource": ["arn:aws:s3:::hook2stream-production-media"]
    },
    {
      "Sid": "ReadProductionProtocolMarker",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::hook2stream-production-media/hook2stream-system/storage-protocol.json"]
    }
  ]
}
