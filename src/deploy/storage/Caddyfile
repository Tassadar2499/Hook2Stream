{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

https://{$STORAGE_TLS_SERVER_NAME}:443 {
	tls /run/tls/tls.crt /run/tls/tls.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@protocol_path path /.well-known/hook2stream-storage-protocol
	handle @protocol_path {
		@protocol_get method GET
		handle @protocol_get {
			header Content-Type "text/plain; charset=utf-8"
			header Cache-Control "no-store"
			respond "1" 200
		}
		respond "method not allowed" 405
	}

	@ready path /healthz
	handle @ready {
		rewrite * /minio/health/ready
		reverse_proxy minio:9000 {
			header_up Host {http.request.hostport}
		}
	}

	# No Hook2Stream S3 bucket or object route begins with /minio. Block the
	# entire internal MinIO namespace so current or future admin, internode,
	# console, metrics, and health endpoints cannot cross the tailnet proxy.
	@private path /minio /minio/*
	handle @private {
		respond "not found" 404
	}

	handle {
		# Preserve path, query, Host, and all SigV4 headers byte-for-byte. Access
		# logging is deliberately absent so object keys never enter Caddy logs.
		reverse_proxy minio:9000 {
			header_up Host {http.request.hostport}
			health_uri /minio/health/ready
			health_interval 30s
			health_timeout 5s
		}
	}
}
