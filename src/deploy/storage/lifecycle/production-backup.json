{
  "Rules": [
    {
      "ID": "hook2stream-production-backup-retention-35d",
      "Status": "Enabled",
      "Filter": { "Prefix": "hook2stream/production/postgres/" },
      "Expiration": { "Days": 35 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 35 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    },
    {
      "ID": "hook2stream-production-backup-delete-markers",
      "Status": "Enabled",
      "Filter": { "Prefix": "hook2stream/production/postgres/" },
      "Expiration": { "ExpiredObjectDeleteMarker": true }
    }
  ]
}
