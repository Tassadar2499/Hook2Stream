#!/bin/sh
set -eu

# Install an environment-specific implementation as root mode 0500 at the path
# configured by HOOK2STREAM_AUTHENTICATED_E2E_HOOK. It must use root-managed
# test credentials without printing them and must cover:
# - invite-only Google OAuth;
# - MP3 upload plus H2SE decrypt and HTTP Range seek;
# - every worker and OpenRouter analysis/artwork;
# - preview, 18 renders and ZIP export;
# - Stripe test/live controlled checkout and duplicate webhook handling.
# - allowed provider egress succeeds and an unrelated HTTPS origin is denied.
#
# With the optional fourth argument `soak-60m`, the implementation must remain
# active for at least 60 minutes while exercising the single render worker and
# a representative sequential render workload for at least 3300 measured job
# seconds. Each minute counts as a network check only after public/API readiness
# and an authenticated small Storj HEAD/Range cycle both pass. Sample /proc/stat
# each minute and retain raw deltas outside stdout: cpuThrottled may be false
# only when no five-minute window exceeds 10 percent steal time and deterministic
# render throughput remains within 20 percent of the accepted same-SKU probe
# baseline. Treat missing samples/baseline as failure; record Docker's expected
# three-vCPU quota separately from provider steal. It must print one
# newline-terminated JSON line and nothing else on stdout:
#
# {"schema":"hook2stream-soak-hook-result-v1","completedRenderCount":1,"renderActiveSeconds":3300,"maxConcurrentRenderJobs":1,"networkChecks":60,"networkFailures":0,"cpuThrottled":false,"oomKilled":false}
#
# This repository template deliberately fails closed. In normal three-argument
# mode, only after every release check succeeds may it print the exact gate line
# below. Stderr is captured in a root-private temporary directory in both modes.
printf '%s\n' "authenticated E2E: replace this fail-closed template" >&2
exit 1

# HOOK2STREAM_E2E_GATE=oauth,h2se-upload-range,workers-openrouter,preview-render18-zip,stripe-idempotency,egress-deny
