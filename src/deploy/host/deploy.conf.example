HOOK2STREAM_ENV_FILE=/srv/hook2stream/config/staging.env
HOOK2STREAM_RELEASES_DIR=/srv/hook2stream/releases
HOOK2STREAM_RELEASE_STATE_DIR=/srv/hook2stream/release-state
HOOK2STREAM_REPOSITORY=OWNER/Hook2Stream
DOCKER_CONFIG=/srv/hook2stream/registry-auth
HOOK2STREAM_GHCR_USERNAME=REPLACE_WITH_ENVIRONMENT_SPECIFIC_READ_PACKAGES_USER
# SHA-256 of the config.json auth field, not the PAT itself:
# jq -jr '.auths["ghcr.io"].auth' "$DOCKER_CONFIG/config.json" | sha256sum
HOOK2STREAM_GHCR_AUTH_SHA256=REPLACE_WITH_64_CHARACTER_LOWERCASE_SHA256
# GitHub login proves usability, not PAT scope. These values pin the operator's
# environment-exclusive read:packages attestation created by the installer.
HOOK2STREAM_GHCR_CREDENTIAL_IDENTITY=hook2stream-staging-REPLACE_WITH_32_LOWERCASE_HEX
HOOK2STREAM_GHCR_IDENTITY_SHA256=REPLACE_WITH_64_CHARACTER_LOWERCASE_SHA256
# Generate with: ssh-keygen -lf PATH_TO_PUBLIC_KEY -E sha256 | awk '{print $2}'
HOOK2STREAM_OPERATOR_PUBLIC_KEY_SHA256=SHA256:REPLACE_WITH_43_CHARACTER_OPENSSH_FINGERPRINT
HOOK2STREAM_DEPLOY_PUBLIC_KEY_SHA256=SHA256:REPLACE_WITH_43_CHARACTER_OPENSSH_FINGERPRINT
HOOK2STREAM_E2E_HOOK=/usr/local/libexec/hook2stream/post-deploy-e2e.sh
HOOK2STREAM_AUTHENTICATED_E2E_HOOK=/usr/local/libexec/hook2stream/authenticated-e2e.sh
# Before the first deployment, set this to that candidate's exact 40-hex SHA.
# It is an identity marker, never a lexical SHA floor.
MIN_ROLLBACK_RELEASE_SHA=REPLACE_WITH_FIRST_H2SE_RELEASE_40_HEX_SHA
# Production only:
HOOK2STREAM_STAGING_SIGNERS=/etc/hook2stream/staging-receipt-allowed-signers
