# Copy to .env. This file intentionally contains identifiers and non-secret
# configuration only. Put secret values in the files documented in secrets/README.md.
COMPOSE_PROJECT_NAME=hook2stream
RELEASE_VERSION=replace-with-git-commit-sha
DEPLOYMENT_ENVIRONMENT=production
SECRET_PROVIDER=file
STORAGE_MODE=external
HOOK2STREAM_RELEASE_STATE_DIR=/srv/hook2stream/release-state

# CI publishes these images, then the immutable release candidate replaces the
# placeholders with registry digest references (image@sha256:...).
API_IMAGE=registry.example/hook2stream-api:replace-with-git-commit-sha
WORKER_IMAGE=registry.example/hook2stream-worker:replace-with-git-commit-sha
BOOTSTRAPPER_IMAGE=registry.example/hook2stream-bootstrapper:replace-with-git-commit-sha
WEB_IMAGE=registry.example/hook2stream-web:replace-with-git-commit-sha
POSTGRES_BACKUP_IMAGE=registry.example/hook2stream-postgres-backup:replace-with-git-commit-sha
EGRESS_PROXY_IMAGE=ubuntu/squid:replace-with-reviewed-digest

# Used only by the disposable local/CI compose.minio.yaml overlay. Deployed app
# hosts always use STORAGE_MODE=external and the separate storage bundle.
MINIO_IMAGE=registry.example/hook2stream-minio:replace-with-reviewed-source-release
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z

# Pin infrastructure images to reviewed digests in the production .env.
CADDY_IMAGE=caddy:2.11.4-alpine
POSTGRES_IMAGE=postgres:17.10-alpine3.24
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.2-p0
DOTNET_SDK_VERSION=10.0.302

APP_DOMAIN=app.example.com
PUBLIC_ORIGIN=https://app.example.com
WWW_DOMAIN=www.example.com
ROBOTS_HEADER=noindex, nofollow, noarchive
CADDYFILE_PATH=./Caddyfile
# Required only for the local/CI MinIO overlay.
S3_PUBLIC_DOMAIN=s3-staging.example.com
ACME_EMAIL=ops@example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0

POSTGRES_DB=hook2stream
POSTGRES_USER=hook2stream
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_WAL_SIZE=2GB

# Deployed profiles replace <tailnet> with the exact environment-specific
# Tailscale name. S3_PUBLIC_SERVICE_URL is retained only for strict legacy
# validation; browsers never receive this URL and MinIO CORS stays disabled.
S3_ENDPOINT_HOST=h2s-storage-production.<tailnet>.ts.net
S3_SERVICE_URL=https://h2s-storage-production.<tailnet>.ts.net
S3_PUBLIC_SERVICE_URL=https://h2s-storage-production.<tailnet>.ts.net
S3_REGION=us-east-1
S3_MEDIA_BUCKET=hook2stream-production-media
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_BUCKET_LIFECYCLE=false
S3_CONFIGURE_MULTIPART_ABORT_LIFECYCLE=false
STORAGE_PROTOCOL_VERSION=1
# Local Compose rendering uses the checked-in deny-by-default configs. The
# deployed environment overlays select ./egress/rendered/<environment>.
EGRESS_CONFIG_DIR=./egress

# Single-host MinIO staging quotas. These cap the buckets, not the whole disk.
MINIO_MEDIA_QUOTA_GIB=180
MINIO_BACKUP_QUOTA_GIB=20

GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
STRIPE_PRICE_ART_CREDITS_5=price_replace_me
STRIPE_PRICE_MINI_RELEASE=price_replace_me
STRIPE_PRICE_RELEASE_PACK=price_replace_me
STRIPE_PRICE_CLEAN_COVER=price_replace_me
STRIPE_PRICE_ACTIVE_ARTIST=price_replace_me

# The remote storage host owns a separate private, versioned backup bucket. Its
# credential is unrelated to runtime and bootstrap media credentials.
BACKUP_S3_ENDPOINT=https://h2s-storage-production.<tailnet>.ts.net
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=hook2stream-production-pg-backups
BACKUP_S3_PREFIX=hook2stream/production/postgres
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_AGE_SECONDS=7200
BACKUP_RETENTION_DAYS=35
BACKUP_RETENTION_SAFETY_SECONDS=7200

# Leave empty to keep telemetry local. Set an HTTPS or private-network OTLP endpoint
# when a collector is deployed.
OTEL_EXPORTER_OTLP_ENDPOINT=

# The MVP uses root-owned files on the encrypted data container. Containers join
# only this numeric supplemental group and receive only their declared secrets.
SECRETS_DIR=/srv/hook2stream/secrets/current
SECRETS_GID=2000

# Optional future Vault provider settings. When enabling Vault, set SECRETS_DIR
# to ${HOOK2STREAM_SECRET_STATE_DIR}/current and render files with SECRETS_GID.
VAULT_AGENT_IMAGE=hashicorp/vault@sha256:replace-with-reviewed-manifest-digest
VAULT_ADDR=https://vault.example.com:8200
VAULT_NAMESPACE=
VAULT_CACERT=/etc/hook2stream/vault-ca.pem
VAULT_AUTH_DIR=/etc/hook2stream/vault-auth
VAULT_CANDIDATE_DIR=/var/lib/hook2stream/secrets/candidate
VAULT_RENDER_UID=0
VAULT_RENDER_GID=2000
