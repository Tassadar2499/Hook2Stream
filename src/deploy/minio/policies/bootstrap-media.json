{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BootstrapMediaBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetLifecycleConfiguration",
        "s3:ListBucket",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::hook2stream-staging-media"
      ]
    }
  ]
}
