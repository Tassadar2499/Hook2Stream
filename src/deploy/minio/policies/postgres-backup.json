{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBackupBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::hook2stream-staging-pg-backups"
      ]
    },
    {
      "Sid": "ListBackupVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::hook2stream-staging-pg-backups"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "hook2stream/staging/postgres",
            "hook2stream/staging/postgres/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteAndExpireBackups",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::hook2stream-staging-pg-backups/hook2stream/staging/postgres/*"
      ]
    }
  ]
}
