COMPOSE_PROJECT_NAME=hook2stream-staging
DEPLOYMENT_ENVIRONMENT=staging
APP_DOMAIN=staging.hook2stream.com
PUBLIC_ORIGIN=https://staging.hook2stream.com
ROBOTS_HEADER=noindex, nofollow, noarchive
CADDYFILE_PATH=./Caddyfile
STORAGE_MODE=external
S3_ENDPOINT_HOST=h2s-storage-staging.<tailnet>.ts.net
S3_SERVICE_URL=https://h2s-storage-staging.<tailnet>.ts.net
S3_PUBLIC_SERVICE_URL=https://h2s-storage-staging.<tailnet>.ts.net
S3_REGION=us-east-1
S3_MEDIA_BUCKET=hook2stream-staging-media
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_BUCKET_LIFECYCLE=false
S3_CONFIGURE_MULTIPART_ABORT_LIFECYCLE=false
STORAGE_PROTOCOL_VERSION=1
EGRESS_CONFIG_DIR=./egress/rendered/staging
BACKUP_S3_ENDPOINT=https://h2s-storage-staging.<tailnet>.ts.net
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=hook2stream-staging-pg-backups
BACKUP_S3_PREFIX=hook2stream/staging/postgres
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_AGE_SECONDS=7200
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_SAFETY_SECONDS=7200
HOOK2STREAM_HOST_ROLE=app
HOOK2STREAM_HOST_ROOT=/srv/hook2stream
HOOK2STREAM_LUKS_BACKING_FILE=/var/lib/hook2stream-data.luks
HOOK2STREAM_LUKS_MAPPER=hook2stream-data
HOOK2STREAM_MIN_VOLUME_GIB=112

# The staging application VM has 8 GiB RAM. Long-running memory limits sum to
# 5952 MiB, leaving at least 2240 MiB for Docker, the kernel, page cache, and
# short-lived deployment tooling. The MinIO overlay keeps its own test limits.
CADDY_MEMORY_LIMIT=96M
CADDY_MEMORY_RESERVATION=32M
WEB_MEMORY_LIMIT=512M
WEB_MEMORY_RESERVATION=96M
API_MEMORY_LIMIT=512M
API_MEMORY_RESERVATION=128M
WORKER_MEDIA_MEMORY_LIMIT=512M
WORKER_MEDIA_MEMORY_RESERVATION=128M
WORKER_ANALYSIS_MEMORY_LIMIT=512M
WORKER_ANALYSIS_MEMORY_RESERVATION=128M
WORKER_CONTROL_MEMORY_LIMIT=384M
WORKER_CONTROL_MEMORY_RESERVATION=128M
WORKER_RENDER_MEMORY_LIMIT=1536M
WORKER_RENDER_MEMORY_RESERVATION=384M
WORKER_EXPORT_MEMORY_LIMIT=384M
WORKER_EXPORT_MEMORY_RESERVATION=128M
BOOTSTRAPPER_MEMORY_LIMIT=512M
PGBOUNCER_MEMORY_LIMIT=96M
PGBOUNCER_MEMORY_RESERVATION=32M
POSTGRES_MEMORY_LIMIT=1024M
POSTGRES_MEMORY_RESERVATION=384M
POSTGRES_BACKUP_MEMORY_LIMIT=192M
POSTGRES_BACKUP_MEMORY_RESERVATION=64M
EGRESS_PROXY_MEMORY_LIMIT=64M
EGRESS_PROXY_MEMORY_RESERVATION=16M
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=384MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB

# Merge these values over .env.example on the host. Staging must use its own
# Google test client, Stripe test identifiers, OpenRouter key, S3 credentials,
# media keyring, session key, invite file, and age recovery recipient.
