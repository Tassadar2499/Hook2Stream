COMPOSE_PROJECT_NAME=hook2stream-production
DEPLOYMENT_ENVIRONMENT=production
APP_DOMAIN=hook2stream.com
PUBLIC_ORIGIN=https://hook2stream.com
ROBOTS_HEADER=index, follow
CADDYFILE_PATH=./Caddyfile.production
STORAGE_MODE=external
STORAGE_PROVISIONING_MODE=VerifyOnly
STORAGE_OBJECT_EXPIRATION_MODE=Storj
S3_ENDPOINT_HOST=gateway.storjshare.io
S3_SERVICE_URL=https://gateway.storjshare.io
S3_REGION=global
S3_MEDIA_BUCKET=hook2stream-com-production-media
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_BUCKET_LIFECYCLE=false
S3_CONFIGURE_MULTIPART_ABORT_LIFECYCLE=false
STORAGE_PROTOCOL_VERSION=1
STORAGE_CONTRACT_KEY=.hook2stream/contracts/storage-v1.json
STORAGE_CONTRACT_SHA256=replace-with-bootstrap-output
H2SE_MAX_CONCURRENT_ENCRYPTIONS=4
H2SE_MAX_CONCURRENT_DOWNLOADS=2
MEDIA_USAGE_THRESHOLD_GIB=160
MEDIA_JANITOR_INTERVAL_SECONDS=86400
MEDIA_JANITOR_MAX_AGE_SECONDS=93600
EGRESS_CONFIG_DIR=./egress/rendered/production
BACKUP_S3_ENDPOINT_HOST=gateway.storjshare.io
BACKUP_S3_ENDPOINT=https://gateway.storjshare.io
BACKUP_S3_REGION=global
BACKUP_S3_BUCKET=hook2stream-com-production-pg-backups
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=hook2stream/production/postgres
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_AGE_SECONDS=7200
BACKUP_RETENTION_DAYS=35
BACKUP_MAX_OBJECT_TTL_HOURS=840
BACKUP_USAGE_THRESHOLD_GIB=30
HOOK2STREAM_HOST_ROLE=app
HOOK2STREAM_HOST_ROOT=/srv/hook2stream
HOOK2STREAM_LUKS_BACKING_FILE=/var/lib/hook2stream-data.luks
HOOK2STREAM_LUKS_MAPPER=hook2stream-data
HOOK2STREAM_MIN_VOLUME_GIB=64

# The permanent Servers.Guru `NL1-4` production VPS has 6 shared vCPU, 8 GiB RAM,
# and a 160 GB NVMe root disk. Long-running container
# limits use at most 6 GiB so Docker, the kernel, page cache, and short-lived
# deployment tooling retain headroom.
CADDY_MEMORY_LIMIT=96M
CADDY_MEMORY_RESERVATION=32M
WEB_MEMORY_LIMIT=512M
WEB_MEMORY_RESERVATION=96M
API_MEMORY_LIMIT=512M
API_MEMORY_RESERVATION=128M
WORKER_MEDIA_MEMORY_LIMIT=512M
WORKER_MEDIA_MEMORY_RESERVATION=128M
WORKER_ANALYSIS_MEMORY_LIMIT=512M
WORKER_ANALYSIS_MEMORY_RESERVATION=128M
WORKER_CONTROL_MEMORY_LIMIT=384M
WORKER_CONTROL_MEMORY_RESERVATION=128M
WORKER_RENDER_MEMORY_LIMIT=1536M
WORKER_RENDER_MEMORY_RESERVATION=384M
WORKER_EXPORT_MEMORY_LIMIT=384M
WORKER_EXPORT_MEMORY_RESERVATION=128M
BOOTSTRAPPER_MEMORY_LIMIT=512M
PGBOUNCER_MEMORY_LIMIT=96M
PGBOUNCER_MEMORY_RESERVATION=32M
POSTGRES_MEMORY_LIMIT=1024M
POSTGRES_MEMORY_RESERVATION=384M
POSTGRES_BACKUP_MEMORY_LIMIT=192M
POSTGRES_BACKUP_MEMORY_RESERVATION=64M
EGRESS_PROXY_MEMORY_LIMIT=64M
EGRESS_PROXY_MEMORY_RESERVATION=16M
STORAGE_JANITOR_MEMORY_LIMIT=128M
STORAGE_JANITOR_MEMORY_RESERVATION=32M
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=384MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB

# Merge these values over .env.example on the host. Production credentials and
# keyrings must never be copied from staging.
