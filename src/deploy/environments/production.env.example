COMPOSE_PROJECT_NAME=hook2stream-production
DEPLOYMENT_ENVIRONMENT=production
APP_DOMAIN=hook2stream.com
PUBLIC_ORIGIN=https://hook2stream.com
WWW_DOMAIN=www.hook2stream.com
ROBOTS_HEADER=index, follow
CADDYFILE_PATH=./Caddyfile.production
STORAGE_MODE=external
S3_ENDPOINT_HOST=h2s-storage-production.<tailnet>.ts.net
S3_SERVICE_URL=https://h2s-storage-production.<tailnet>.ts.net
S3_PUBLIC_SERVICE_URL=https://h2s-storage-production.<tailnet>.ts.net
S3_REGION=us-east-1
S3_MEDIA_BUCKET=hook2stream-production-media
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_BUCKET_LIFECYCLE=false
S3_CONFIGURE_MULTIPART_ABORT_LIFECYCLE=false
STORAGE_PROTOCOL_VERSION=1
EGRESS_CONFIG_DIR=./egress/rendered/production
BACKUP_S3_ENDPOINT=https://h2s-storage-production.<tailnet>.ts.net
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=hook2stream-production-pg-backups
BACKUP_S3_PREFIX=hook2stream/production/postgres
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_AGE_SECONDS=7200
BACKUP_RETENTION_DAYS=35
BACKUP_RETENTION_SAFETY_SECONDS=7200
HOOK2STREAM_HOST_ROLE=app
HOOK2STREAM_HOST_ROOT=/srv/hook2stream
HOOK2STREAM_LUKS_BACKING_FILE=/var/lib/hook2stream-data.luks
HOOK2STREAM_LUKS_MAPPER=hook2stream-data
HOOK2STREAM_MIN_VOLUME_GIB=176

# Production retains the original 16 GiB single-node service ceilings.
CADDY_MEMORY_LIMIT=256M
CADDY_MEMORY_RESERVATION=64M
WEB_MEMORY_LIMIT=512M
WEB_MEMORY_RESERVATION=128M
API_MEMORY_LIMIT=1G
API_MEMORY_RESERVATION=256M
WORKER_MEDIA_MEMORY_LIMIT=1536M
WORKER_MEDIA_MEMORY_RESERVATION=256M
WORKER_ANALYSIS_MEMORY_LIMIT=1536M
WORKER_ANALYSIS_MEMORY_RESERVATION=256M
WORKER_CONTROL_MEMORY_LIMIT=1G
WORKER_CONTROL_MEMORY_RESERVATION=256M
WORKER_RENDER_MEMORY_LIMIT=3G
WORKER_RENDER_MEMORY_RESERVATION=512M
WORKER_EXPORT_MEMORY_LIMIT=1G
WORKER_EXPORT_MEMORY_RESERVATION=256M
BOOTSTRAPPER_MEMORY_LIMIT=768M
PGBOUNCER_MEMORY_LIMIT=256M
PGBOUNCER_MEMORY_RESERVATION=64M
POSTGRES_MEMORY_LIMIT=3G
POSTGRES_MEMORY_RESERVATION=1G
POSTGRES_BACKUP_MEMORY_LIMIT=512M
POSTGRES_BACKUP_MEMORY_RESERVATION=128M
EGRESS_PROXY_MEMORY_LIMIT=128M
EGRESS_PROXY_MEMORY_RESERVATION=32M

# Merge these values over .env.example on the host. Production credentials and
# keyrings must never be copied from staging.
