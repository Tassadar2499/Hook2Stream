COMPOSE_PROJECT_NAME=hook2stream-production
DEPLOYMENT_ENVIRONMENT=production
APP_DOMAIN=hook2stream.com
PUBLIC_ORIGIN=https://hook2stream.com
WWW_DOMAIN=www.hook2stream.com
ROBOTS_HEADER=index, follow
CADDYFILE_PATH=./Caddyfile.production
STORAGE_MODE=external
S3_SERVICE_URL=https://fsn1.your-objectstorage.com
S3_PUBLIC_SERVICE_URL=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_MEDIA_BUCKET=hook2stream-production-media
S3_FORCE_PATH_STYLE=false
S3_CONFIGURE_MULTIPART_ABORT_LIFECYCLE=true
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_REGION=fsn1
BACKUP_S3_BUCKET=hook2stream-production-pg-backups
BACKUP_S3_PREFIX=hook2stream/production/postgres
BACKUP_INTERVAL_SECONDS=3600
BACKUP_MAX_AGE_SECONDS=7200
BACKUP_RETENTION_DAYS=35
BACKUP_RETENTION_SAFETY_SECONDS=7200
HOOK2STREAM_MIN_VOLUME_GIB=128

# Merge these values over .env.example on the host. Production credentials and
# keyrings must never be copied from staging.
